# ============================================
# BigTapp Agentic Chatbot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# AZURE OPENAI CONFIGURATION (Required)
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Chat LLM (for routing, intent detection)
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_TEMPERATURE=0.2

# Response LLM (for user-facing responses, can be same as chat)
AZURE_OPENAI_RESPONSE_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_RESPONSE_TEMPERATURE=0.3

# Embeddings (for RAG)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
# Optional: Use separate Azure resource for embeddings
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_API_KEY=your-embedding-api-key
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-15-preview

# ============================================
# REDIS CONFIGURATION (Required)
# ============================================
REDIS_PASSWORD=your-redis-password
REDIS_PORT=6380
REDIS_URL=redis://:your-redis-password@localhost:6380/0

# Session TTL (seconds) - how long to keep session data
AGENTIC_SESSION_TTL_SECONDS=900

# Use Redis for LangGraph conversation persistence (true/false)
AGENTIC_USE_REDIS_CHECKPOINTER=true

# Idle session reset threshold (seconds)
SESSION_IDLE_RESET_SECONDS=900

# Rate limiting
RL_WINDOW_SECONDS=60
RL_MAX_MESSAGES=10

# Deduplication TTL - ignore duplicate messages within this window (seconds)
# WhatsApp sometimes retries delivery, this prevents double-processing
DEDUPE_TTL_SECONDS=86400

# ============================================
# MONGODB CONFIGURATION (Required for history)
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-mongo-password
MONGO_PORT=27017
MONGO_URI=mongodb://admin:your-mongo-password@localhost:27017
DB_NAME=bigtapp

# Collection name for agentic conversation history
AGENTIC_HISTORY_COLLECTION=agentic_conversation_history

# ============================================
# WEAVIATE CONFIGURATION (Required for RAG)
# ============================================
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_GRPC_PORT=50051

# ============================================
# WHATSAPP / META CONFIGURATION (Optional)
# ============================================
META_VERIFY_TOKEN=your-verify-token
META_ACCESS_TOKEN=your-access-token
META_PHONE_NUMBER_ID=your-phone-number-id

# Optional: App secret for webhook signature verification (recommended for production)
# If not set, signature verification is skipped
# META_APP_SECRET=your-app-secret

# Send quick "Got it..." acknowledgment before processing (true/false)
# Improves perceived latency but adds an extra message
WA_SEND_ACKS=false

# ============================================
# ZOOM CONTACT CENTER (Optional - Live Agent)
# ============================================
ZOOM_BASE_URL=https://us01cciapi.zoom.us
ZOOM_API_KEY=your-zoom-api-key
ZOOM_SDK_RESOURCE=your-zoom-sdk-resource

# ============================================
# IDLE SESSION MONITOR
# ============================================
# Enable/disable idle farewell messages (true/false)
ENABLE_IDLE_FAREWELL=false

# Seconds of inactivity before sending farewell (0 = disabled)
IDLE_FAREWELL_SECONDS=900

# Custom farewell message
# IDLE_FAREWELL_MESSAGE=It looks like you haven't sent any new questions for a while, so I'll close this chat now. If you need anything else, just message me again. Have a great day!

# How often to scan for idle sessions (seconds)
IDLE_MONITOR_POLL_SECONDS=60

# ============================================
# PERFORMANCE TUNING
# ============================================
# HTTP connection pool size (for concurrent requests)
AGENTIC_HTTP_POOL_SIZE=100

# HTTP request timeout (seconds)
AGENTIC_HTTP_TIMEOUT=30.0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# LLM PROVIDER (Optional)
# ============================================
# Options: azure, grok
LLM_PROVIDER=azure

# Grok Configuration (if using Grok)
# GROK_OPENAI_ENDPOINT=https://grokmodl-resource.services.ai.azure.com/openai/v1/
# GROK_OPENAI_API_KEY=your-grok-api-key
# GROK_OPENAI_DEPLOYMENT_NAME=grok-4-fast-non-reasoning
